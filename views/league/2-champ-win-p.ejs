<div class="form-container">
      <h2>Duo</h2>
      <form action="/lol2champ" method="POST">

        <label for="lol2ChampPlayer1">Player 1:</label>
        <select id="lol2ChampPlayer1" name="player1">
          <option value="">-- Pick Player --</option>
          <option value="Cody">Cody</option>
          <option value="Sammy">Sammy</option>
          <option value="Jason">Jason</option>
        </select>

        <label for="lol2ChampWinPChamp1">Champion 1:</label>
        <select id="lol2ChampWinPChamp1" name="champ1">
          <option value="">-- Pick Champion --</option>
            <% availChamps.forEach(champ => { %>
              <option value="<%= champ %>"><%= champ %></option>
            <% }); %>
        </select>

        <label for="lol2ChampWinPLane1">Lane 1:</label>
        <select id="lol2ChampWinPLane1" name="lane1">
          <option value="">-- Pick Lane --</option>
            <% availLanes.forEach(lane => { %>
              <option value="<%= lane %>"><%= lane %></option>
            <% }); %>
        </select>

        <label for="lol2ChampPlayer2">Player 2:</label>
        <select id="lol2ChampPlayer2" name="player2">
          <option value="">-- Pick Player --</option>
          <option value="Cody">Cody</option>
          <option value="Sammy">Sammy</option>
          <option value="Jason">Jason</option>
        </select>

        <label for="lol2ChampWinPChamp2">Champion 2:</label>
        <select id="lol2ChampWinPChamp2" name="champ2">
          <option value="">-- Pick Champion --</option>
            <% availChamps.forEach(champ => { %>
              <option value="<%= champ %>"><%= champ %></option>
            <% }); %>
        </select>

        <label for="lol2ChampWinPLane2">Lane 2:</label>
        <select id="lol2ChampWinPLane2" name="lane2">
          <option value="">-- Pick Lane --</option>
            <% availLanes.forEach(lane => { %>
              <option value="<%= lane %>"><%= lane %></option>
            <% }); %>
        </select>

        <button type="submit">Submit</button>
        
        <h3 id="results">
          <%= locals.result ? `${twoChampWinP}% WR, KDA: ${twoChampKda}, Games: ${twoChampTotalGames}` : "" %>
          <%= locals.twoChampInvalid ? `No games found together` : "" %>
        </h3>

      </form>
    </div>