<div class="form-container">
      <h2>Duo KDA</h2>
      <form action="/2champkda" method="POST">

        <label for="player1">Player 1:</label>
        <select id="player1" name="player1">
          <option value="">-- Pick Player --</option>
          <option value="Cody">Cody</option>
          <option value="Sammy">Sammy</option>
          <option value="Jason">Jason</option>
        </select>

        <label for="champ1">Champion 1:</label>
        <select id="champ1" name="champ1">
          <option value="">-- Pick Champion --</option>
            <% availChamps.forEach(champ => { %>
              <option value="<%= champ %>"><%= champ %></option>
            <% }); %>
        </select>


        <label for="lane1">Lane 1:</label>
        <select id="lane1" name="lane1">
          <option value="">-- Pick Lane --</option>
            <% availLanes.forEach(lane => { %>
              <option value="<%= lane %>"><%= lane %></option>
            <% }); %>
        </select>

        <label for="player2">Player 2:</label>
        <select id="player2" name="player2">
          <option value="">-- Pick Player --</option>
          <option value="Cody">Cody</option>
          <option value="Sammy">Sammy</option>
          <option value="Jason">Jason</option>
        </select>

        <label for="champ2">Champion 2:</label>
        <select id="champ2" name="champ2">
          <option value="">-- Pick Champion --</option>
            <% availChamps.forEach(champ => { %>
              <option value="<%= champ %>"><%= champ %></option>
            <% }); %>
        </select>

        <label for="lane2">Lane 2:</label>
        <select id="lane2" name="lane2">
          <option value="">-- Pick Lane --</option>
            <% availLanes.forEach(lane => { %>
              <option value="<%= lane %>"><%= lane %></option>
            <% }); %>
        </select>

        <button type="submit">Submit</button>
        
        <h3 id="results">
          <%= locals.twoChampKda ? `${twoChampKda} KDA in ${twoChampKdaTotalGames} games` : "" %>
          <%= locals.twoChampKdaInvalid ? `No games found together` : "" %>
        </h3>

      </form>
    </div>